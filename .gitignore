node_modules/
.env
.DS_Store

# per-SKU intermediates + node_modules — do NOT commit.
# Keep the source photos (inputs/) and the final deliverables (white + gray).
outputs/*
!outputs/finals/
!outputs/finals_gray/
!outputs/contact_sheet.jpg
!outputs/contact_sheet_gray.jpg
!outputs/finals_plush_f7f7f7_all/
!outputs/compare_plush_normal_fur_nofur.jpg
!outputs/contact_sheet_group_sofa.jpg
!outputs/qc_group_sofa_consistency.jpg
!outputs/finals_sofa_f7f7f7/
!outputs/contact_sheet_sofa_f7f7f7_group_sofa.jpg
!outputs/qc_group_sofa_texture.jpg
!outputs/client_sofa_f7f7f7/
!outputs/client_sofa_f7f7f7.zip

# local review bundles (large, regenerated on demand)
/plush_review/
/sofa_review/
/plush_f7f7f7_review.zip

# Source photos for group_chair are NOT committed — manifest.json records the SKU,
# product page and CDN URL for each, so the set is refetchable. Keeps image blobs
# out of the history (the repo is already ~200 MB of committed finals).
inputs/group_chair/*.jpg

# Categorization set (docs/categories.md): manifests + selection are tracked, the fetched JPEGs are not —
# `node scripts/fetch_ikea.mjs fetch inputs/catalog_selection.json` re-downloads them.
inputs/group_*/*.jpg

# Categorization-run evidence cited by docs/categories.md: contact sheets + QC inspection images
# (~10 MB). The full-res category finals (outputs/catalog_finals/ etc., ~160 MB) stay local.
!outputs/catalog_contact_sheet.jpg
!outputs/catalog_sheet_*.jpg
!outputs/catalog_relight_sheet_*.jpg
!outputs/catalog_relight_ha_sheet_*.jpg
!outputs/catalog_relight_dark_sh_sheet_*.jpg
!outputs/catalog_qc_*.jpg
!outputs/catalog_logs/
